{
    "name": "horde/ingo",
    "description": "Email filter rules manager application",
    "type": "horde-application",
    "homepage": "https://www.horde.org/apps/ingo",
    "license": "Apache-1.0",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "filter",
        "procmail",
        "sieve"
    ],
    "time": "2026-05-18",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "^3 || ^2",
        "php": "^7.4 || ^8",
        "horde/horde": "^6",
        "horde/auth": "^3",
        "horde/autoloader": "^3",
        "horde/core": "^3",
        "horde/exception": "^3",
        "horde/group": "^3",
        "horde/form": "^3",
        "horde/imap_client": "^3",
        "horde/managesieve": "^2",
        "horde/mime": "^3",
        "horde/perms": "^3",
        "horde/share": "^3",
        "horde/util": "^3",
        "horde/view": "^3",
        "ext-gettext": "*"
    },
    "require-dev": {},
    "suggest": {
        "horde/listheaders": "^2",
        "horde/mongo": "^2",
        "horde/vfs": "^3"
    },
    "autoload": {
        "classmap": [
            "lib/"
        ],
        "psr-4": {
            "Horde\\Ingo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Ingo\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/ingo-admin-upgrade",
        "bin/ingo-convert-prefs-to-sql",
        "bin/ingo-convert-sql-shares-to-sqlng",
        "bin/ingo-postfix-policyd"
    ],
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    }
}