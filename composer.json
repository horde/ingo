{
    "name": "horde/ingo",
    "description": "Email filter rules manager application",
    "type": "horde-application",
    "homepage": "https://www.horde.org/apps/ingo",
    "license": "Apache-1.0",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-03-07",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "dev-FRAMEWORK_6_0 || ^3 || ^2",
        "php": "^7.4 || ^8",
        "horde/horde": "^6 || dev-FRAMEWORK_6_0",
        "horde/auth": "^3 || dev-FRAMEWORK_6_0",
        "horde/autoloader": "^3 || dev-FRAMEWORK_6_0",
        "horde/core": "^3 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/group": "^3 || dev-FRAMEWORK_6_0",
        "horde/form": "^3 || dev-FRAMEWORK_6_0",
        "horde/imap_client": "^3 || dev-FRAMEWORK_6_0",
        "horde/managesieve": "^2 || dev-FRAMEWORK_6_0",
        "horde/mime": "^3 || dev-FRAMEWORK_6_0",
        "horde/perms": "^3 || dev-FRAMEWORK_6_0",
        "horde/share": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0",
        "horde/view": "^3 || dev-FRAMEWORK_6_0",
        "ext-gettext": "*"
    },
    "require-dev": {},
    "suggest": {
        "horde/listheaders": "^2 || dev-FRAMEWORK_6_0",
        "horde/mongo": "^2 || dev-FRAMEWORK_6_0",
        "horde/vfs": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Ingo": "lib/"
        },
        "psr-4": {
            "Horde\\Ingo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Ingo\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/ingo-admin-upgrade",
        "bin/ingo-convert-prefs-to-sql",
        "bin/ingo-convert-sql-shares-to-sqlng",
        "bin/ingo-postfix-policyd"
    ],
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "4.x-dev"
        }
    }
}