// Rules Storage
// ----------------------------------------------------------------------

// What storage driver should we use?
// Options:
//   'prefs' - Preference System
//   'nosql' - NoSQL
//   'sql' - SQL
$conf['storage']['driver'] = 'sql';

// Database configuration
// Configure your database connection parameters
$conf['storage']['params']['phptype'] = 'mysqli';
$conf['storage']['params']['hostspec'] = 'localhost';
$conf['storage']['params']['username'] = '';
$conf['storage']['params']['password'] = '';
$conf['storage']['params']['database'] = '';
$conf['storage']['params']['charset'] = 'utf8mb4';
$conf['storage']['params']['ssl'] = false;



// ----------------------------------------------------------------------
// Rules Options
// ----------------------------------------------------------------------

// Allow users to manually enter Header   fields to search by in the Rule edit screen?
$conf['rules']['userheader'] = true;


// ----------------------------------------------------------------------
// Spam Filtering
// ----------------------------------------------------------------------

