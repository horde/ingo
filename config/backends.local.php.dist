<?php
/**
 * Ingo Local Backend Configuration Example
 *
 * This file shows example configurations for local backend overrides.
 * Copy this to backends.local.php and uncomment the configuration you need.
 *
 * IMPORTANT: Local overrides MUST be placed in backends.local.php
 * (or backends.d/ directory). This allows you to enable/disable backends
 * and customize settings without modifying the main backends.php file.
 */

/**
 * Example 1: Enable Null Driver for Development/Testing
 *
 * The null driver stores rules but does not deploy them to any mail server.
 * Useful for UI development, testing, and demonstrations.
 *
 * Uncomment to enable:
 */
// $backends['null']['disabled'] = false;

/**
 * Example 2: Disable IMAP Driver
 *
 * If you want to use a different backend as the default, disable IMAP:
 */
// $backends['imap']['disabled'] = true;

/**
 * Example 3: Enable and Configure Sieve Driver
 *
 * Enable Sieve backend and point to your Managesieve server:
 */
// $backends['sieve']['disabled'] = false;
// $backends['sieve']['transport'][Ingo::RULE_ALL]['params']['hostspec'] = 'sieve.example.com';
// $backends['sieve']['transport'][Ingo::RULE_ALL]['params']['port'] = 4190;

/**
 * Example 4: Use Null Driver as Default in Development
 *
 * For development environments, you can make null the only available backend:
 */
// $backends['imap']['disabled'] = true;
// $backends['sieve']['disabled'] = true;
// $backends['maildrop']['disabled'] = true;
// $backends['procmail']['disabled'] = true;
// $backends['null']['disabled'] = false;
